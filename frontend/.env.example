# === Supabase Configuration ===
# Get these from: https://supabase.com/dashboard → Project → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Custom Edge Functions URL (defaults to VITE_SUPABASE_URL)
VITE_SUPABASE_FUNCTIONS_URL=https://your-project-id.supabase.co

# Optional: where Supabase verification/reset links should send users
VITE_AUTH_REDIRECT_URL=https://your-app-domain.com/loginVITE_RAZORPAY_KEY_ID=your_razorpay_key_here
